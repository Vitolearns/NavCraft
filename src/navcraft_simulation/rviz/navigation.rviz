Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 35; 38; 42
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.7
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Depth: 5
      Size (m): 0.035
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 40; 210; 120
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: Collision checked arc
      Enabled: true
      Topic:
        Value: /lookahead_collision_arc
      Color: 255; 180; 30
      Line Style: Lines
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.35
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 65
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 850
